# =============================================================================
# LACKADAISICAL AI CHAT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your settings
# All data is processed locally by default for privacy

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
FRONTEND_PORT=3000
BACKEND_PORT=3001
BACKEND_HOST=localhost
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database type: sqlite, postgresql, mysql
DB_TYPE=sqlite

# SQLite Configuration (default)
DB_PATH=./database/chat.db
DB_ENCRYPTED=false
DB_PASSPHRASE=

# PostgreSQL Configuration (optional)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=lackadaisical_chat
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_SSL=false
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# MySQL Configuration (optional)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=lackadaisical_chat
# DB_USERNAME=root
# DB_PASSWORD=your_password
# DB_SSL=false
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# Primary AI provider: ollama, openai, anthropic, google, xai
AI_PRIMARY_PROVIDER=ollama

# Streaming mode: sse, ws, off
AI_STREAM_MODE=sse

# Context window size (gpt-oss:20b supports 256k)
AI_CONTEXT_WINDOW=262144

# Extended thinking (chain-of-thought reasoning)
EXTENDED_THINKING=true

# Ollama model configurations
OLLAMA_DEFAULT_MODEL=gpt-oss:20b
OLLAMA_UNCENSORED_MODEL=lackadaisical-uncensored:latest
OLLAMA_VISION_MODEL=gemma4:e4b
OLLAMA_AVAILABLE_MODELS=gpt-oss:20b,gemma4:e4b,lackadaisical-assistant:latest,lackadaisical-uncensored:latest,llama3.3:latest,mistral:latest,phi4:latest,codellama:latest

# External provider model selections
AI_MODEL_OPENAI=gpt-5.4
AI_MODEL_ANTHROPIC=claude-sonnet-4-6
AI_MODEL_GOOGLE=gemini-3.1-flash
AI_MODEL_XAI=grok-4-1-fast-reasoning

# Ollama configuration
OLLAMA_HOST=http://localhost:11434

# Ollama Cloud (optional - for cloud model access)
# OLLAMA_CLOUD_URL=https://api.ollama.com
# OLLAMA_CLOUD_API_KEY=your-ollama-cloud-api-key

# OPENAI_API_KEY=change-this-to-your-openai-key
# ANTHROPIC_API_KEY=change-this-to-your-anthropic-key
# GOOGLE_API_KEY=change-this-to-your-google-key
# XAI_API_KEY=change-this-to-your-xai-key

# =============================================================================
# PERSONALITY CONFIGURATION
# =============================================================================
PERSONALITY_NAME=Lacky
PERSONALITY_BASE_TRAITS=friendly,curious,helpful,witty
PERSONALITY_MOOD_VOLATILITY=0.3
PERSONALITY_EMPATHY_THRESHOLD=0.7

# =============================================================================
# PLUGIN CONFIGURATION
# =============================================================================
PLUGINS_ENABLED=weather,horoscope,poem-of-the-day
PLUGINS_AUTO_LOAD=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_JOURNALING=true
FEATURE_WEB_SEARCH=true
FEATURE_DEEP_RESEARCH=true
FEATURE_FILE_UPLOAD=true
FEATURE_TOOL_USE=true
FEATURE_CODE_BLOCKS=true
FEATURE_EXTENDED_THINKING=true
FEATURE_ENCRYPTION=false
FEATURE_DAILY_REMINDERS=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate secure secrets for production
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
SESSION_SECRET=your_session_secret_key_here_minimum_32_characters

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
NODE_ENV=development
DEBUG_MODE=false

# =============================================================================
# WEB SEARCH CONFIGURATION
# =============================================================================
WEB_SEARCH_TIMEOUT=30000
WEB_SEARCH_MAX_RESULTS=10
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key
# SERPAPI_KEY=your-serpapi-key

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# =============================================================================
# JOURNAL CONFIGURATION
# =============================================================================
JOURNAL_REMINDER_TIME=21:00
JOURNAL_REMINDER_TIMEZONE=America/New_York

# =============================================================================
# PRODUCTION NOTES
# =============================================================================
# For production deployment:
# 1. Set NODE_ENV=production
# 2. Generate secure JWT_SECRET and SESSION_SECRET
# 3. Configure proper database (PostgreSQL recommended for production)
# 4. Set up proper CORS origins
# 5. Enable encryption if needed
# 6. Configure external AI providers if desired
# 7. Set up proper logging and monitoring 